<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latestMajor</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Legacy.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	  <PackageReference Include="BepInEx.Core" Version="5.4.21" />
	  <PackageReference Include="bouncyshield-LemurianNames" Version="1.0.2" />
	  <PackageReference Include="KingEnderBrine-ProperSave" Version="2.13.2" />
	  <PackageReference Include="R2API.ContentManagement" Version="1.1.0" />
	  <PackageReference Include="R2API.Core" Version="5.3.0" />
	  <PackageReference Include="R2API.Elites" Version="1.1.3" />
	  <PackageReference Include="R2API.Prefab" Version="1.1.1" />
	  <PackageReference Include="R2API.RecalculateStats" Version="1.6.6" />
	  <PackageReference Include="R2API.TempVisualEffect" Version="1.0.3" />
	  <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
	  <PackageReference Include="RoR2BepInExPack" Version="1.46.0" />
	  <PackageReference Include="Rune580.Mods.RiskOfRain2.RiskOfOptions" Version="2.8.6" />
	  <PackageReference Include="MMHOOK.RoR2" Version="2026.10.8">
	  <NoWarn>NU1701</NoWarn>
    </PackageReference>
	  <PackageReference Include="score-MiscFixes" Version="1.5.1" />
  </ItemGroup>

    <ItemGroup>
        <Publicize Include="HGUnityUtils" />
        <Publicize Include="0Harmony" />
    </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="call weave.bat $(TargetDir) $(AssemblyName)" />
  </Target>

</Project>
